{
  "cli": "gk",
  "version": "0.2.0",
  "commands": [
    {
      "name": "init",
      "description": "Install the GraphKit kit into the current project",
      "options": ["--json", "--force", "--target <target>"]
    },
    {
      "name": "new",
      "description": "Scaffold a new project with the GraphKit kit",
      "options": ["--dir <dir>", "--json", "--target <target>"]
    },
    {
      "name": "validate",
      "description": "Validate a graph.yaml",
      "options": ["--json"]
    },
    {
      "name": "compile",
      "description": "Compile graph.yaml to a .workflow.js script",
      "options": ["--output <path>", "--json"]
    },
    {
      "name": "graph list",
      "description": "List canonical topologies",
      "options": ["--json"]
    },
    {
      "name": "graph inspect",
      "description": "Inspect a topology's config keys",
      "options": ["--json"]
    },
    {
      "name": "graph new",
      "description": "Emit a graph.yaml template for a topology",
      "options": ["--json"]
    },
    {
      "name": "graph ascii",
      "description": "Render an ASCII diagram",
      "options": ["--json"]
    },
    {
      "name": "graph svg",
      "description": "Render an SVG export",
      "options": ["--json"]
    },
    {
      "name": "graph waves",
      "description": "Output topological wave structure",
      "options": ["--json"]
    },
    {
      "name": "graph index",
      "description": "Index memory into CBM",
      "options": ["--json"]
    },
    {
      "name": "graph search",
      "description": "Search the CBM memory graph",
      "options": ["--json"]
    },
    {
      "name": "graph trace",
      "description": "Trace calls/callees in the CBM graph",
      "options": ["--json"]
    },
    {
      "name": "graph query",
      "description": "Run a Cypher query against the CBM graph",
      "options": ["--json"]
    },
    {
      "name": "memory index",
      "description": "Index .graphkit/memory/ into the CBM memory project",
      "options": ["--project <project>", "--json"]
    },
    {
      "name": "template pack",
      "description": "Package a graph.yaml as a reusable GraphTemplate",
      "options": ["--name <name>", "--global", "--force", "--input <file>"]
    },
    {
      "name": "template list",
      "description": "List packaged templates",
      "options": ["--json"]
    },
    {
      "name": "template show",
      "description": "Show a packaged template",
      "options": ["--json"]
    },
    {
      "name": "inventory",
      "description": "Inventory installed agents, skills, tools, and MCP servers",
      "options": ["--target <target>", "--json"]
    }
  ]
}
