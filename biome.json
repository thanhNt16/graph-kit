{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git" },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!dist",
      "!kits/claude/templates",
      "!kits/claude/skills/excalidraw-diagram",
      "!kits/claude/hooks",
      "!kits/claude/topology",
      "!kits/cursor",
      "!kits/opencode/skill/excalidraw-diagram",
      "!kits/codex/skills/excalidraw-diagram",
      "!kits/pi/skills/excalidraw-diagram",
      "!.omp/skills/excalidraw-diagram",
      "!.claude",
      "!.graphkit",
      "!**/.tmp-*",
      "!src/viewer/app.ts",
      "!kits/*/viewer",
      "!docs/**/*.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  }
}
