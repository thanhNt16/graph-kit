{
  "name": "@graphkit/gk",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "gk": "dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --outdir=dist && chmod +x dist/index.js",
    "build:bin": "bun build --compile src/index.ts --outfile=dist/gk",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "eval": "bun run src/eval/replay-cli.ts",
    "cbm:parity": "bun run scripts/cbm-parity.ts",
    "prepack": "bun run build",
    "check-changelog": "bun run scripts/check-changelog.ts",
    "ci:local": "bun run typecheck && bun run lint && bun run build && bun test && bun run cbm:parity && bun run check-changelog",
    "eval:memory": "bun run scripts/memory-recall-eval.ts"
  },
  "files": [
    "kits/",
    "templates/gallery"
  ],
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cac": "^6.7.14",
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  }
}
