{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-execute-verify/plan.schema.json",
  "title": "Task plan",
  "type": "object",
  "description": "The implementation plan produced by the planner agent. One-step plan list under summary.",
  "additionalProperties": false,
  "required": ["summary"],
  "properties": {
    "summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "task"],
        "properties": { "id": { "type": "string", "minLength": 1 }, "task": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
