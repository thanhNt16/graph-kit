{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/graph-state-guard.cjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/evidence-persist.cjs" },
          { "type": "command", "command": "node .claude/hooks/memory-persist.cjs" }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/lease-enforce.cjs" }
        ]
      }
    ]
  },
  "skillListingBudgetFraction": 0.04,
  "skillListingMaxDescChars": 512
}
